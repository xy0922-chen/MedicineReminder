<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/app_background">
  <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:orientation="vertical" android:padding="20dp" android:layout_weight="1">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
      <ImageView android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ui_ic_record" android:padding="8dp" android:contentDescription="@null" android:importantForAccessibility="no" android:focusable="false" android:clickable="false" android:background="@drawable/bg_ui_icon" />
      <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/history_title" android:textColor="@color/brand_primary_dark" android:textSize="28sp" android:textStyle="bold" android:layout_weight="1" android:layout_marginStart="12dp" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/history_help" android:textColor="@color/app_muted" android:textSize="16sp" android:lineSpacingExtra="4dp" />
    <RadioGroup android:id="@+id/rgHistoryRange" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:checkedButton="@id/rbHistoryToday" android:layout_marginTop="12dp" android:background="@drawable/bg_ui_filter" android:padding="4dp">
      <RadioButton android:id="@+id/rbHistoryToday" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp" android:text="@string/history_today" android:textSize="18sp" android:textColor="@color/record_filter_text" android:buttonTint="@color/brand_primary" android:button="@null" android:background="@drawable/bg_record_filter" android:gravity="center" android:padding="8dp" android:layout_margin="3dp" />
      <RadioButton android:id="@+id/rbHistoryWeek" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp" android:text="@string/history_week" android:textSize="18sp" android:textColor="@color/record_filter_text" android:buttonTint="@color/brand_primary" android:button="@null" android:background="@drawable/bg_record_filter" android:gravity="center" android:padding="8dp" android:layout_margin="3dp" />
      <RadioButton android:id="@+id/rbHistoryAll" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp" android:text="@string/history_all" android:textSize="18sp" android:textColor="@color/record_filter_text" android:buttonTint="@color/brand_primary" android:button="@null" android:background="@drawable/bg_record_filter" android:gravity="center" android:padding="8dp" android:layout_margin="3dp" />
    </RadioGroup>
    <TextView android:id="@+id/tvHistoryCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:textColor="@color/app_muted" android:accessibilityLiveRegion="polite" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="12dp">
      <ListView android:id="@+id/lvHistory" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@android:color/transparent" android:dividerHeight="12dp" />
      <TextView android:id="@+id/tvHistoryEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" android:gravity="center" android:text="@string/history_empty" android:textSize="20sp" android:textColor="@color/app_muted" android:drawableTop="@drawable/ui_ic_record" android:drawablePadding="14dp" />
    </FrameLayout>
    <Button android:id="@+id/btnHistoryBack" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/history_back" android:visibility="gone" style="@style/MedicineSecondaryButton" />
  </LinearLayout>
  <include layout="@layout/view_bottom_navigation" />
</LinearLayout>
