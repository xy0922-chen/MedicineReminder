<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#F1F7F3">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/history_title" android:textColor="#174D39" android:textSize="28sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/history_help" android:textColor="#52685A" android:textSize="16sp" />
        <RadioGroup android:id="@+id/rgHistoryRange" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="horizontal"
            android:checkedButton="@id/rbHistoryToday" android:layout_marginTop="12dp">
            <RadioButton android:id="@+id/rbHistoryToday" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp"
                android:text="@string/history_today" android:textSize="18sp" android:textColor="#203B2E" />
            <RadioButton android:id="@+id/rbHistoryWeek" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp"
                android:text="@string/history_week" android:textSize="18sp" android:textColor="#203B2E" />
            <RadioButton android:id="@+id/rbHistoryAll" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp"
                android:text="@string/history_all" android:textSize="18sp" android:textColor="#203B2E" />
        </RadioGroup>
        <TextView android:id="@+id/tvHistoryCount" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="16sp" android:textColor="#52685A"
            android:accessibilityLiveRegion="polite" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:layout_marginTop="12dp">
            <ListView android:id="@+id/lvHistory" android:layout_width="match_parent"
                android:layout_height="match_parent" android:divider="@android:color/transparent" android:dividerHeight="12dp" />
            <TextView android:id="@+id/tvHistoryEmpty" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:padding="20dp" android:gravity="center"
                android:text="@string/history_empty" android:textSize="20sp" android:textColor="#52685A" />
        </FrameLayout>
        <Button android:id="@+id/btnHistoryBack" style="@style/MedicineSecondaryButton"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/history_back" />
    </LinearLayout>
</LinearLayout>
