<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/app_background">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
      <ImageView android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ui_ic_bell" android:padding="8dp" android:contentDescription="@null" android:importantForAccessibility="no" android:focusable="false" android:clickable="false" android:background="@drawable/bg_ui_icon" />
      <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/reminder_settings_title" android:textSize="28sp" android:textStyle="bold" android:textColor="@color/brand_primary_dark" android:layout_weight="1" android:layout_marginStart="12dp" />
    </LinearLayout>
    <TextView android:id="@+id/tvReminderStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:padding="18dp" android:background="@drawable/bg_medicine_card" android:textSize="20sp" android:textColor="@color/app_ink" android:accessibilityLiveRegion="polite" android:lineSpacingExtra="7dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/reminder_help" android:textSize="18sp" android:textColor="@color/app_muted" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false" android:layout_marginTop="12dp">
      <Button android:id="@+id/btnNotificationPermission" style="@style/MedicineSecondaryButton" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/reminder_notification_permission" android:drawableStart="@drawable/ui_ic_bell" android:drawablePadding="10dp" android:drawableTint="@color/brand_primary" android:layout_weight="1" android:textSize="18sp" />
      <Button android:id="@+id/btnExactPermission" style="@style/MedicineSecondaryButton" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/reminder_exact_permission" android:drawableStart="@drawable/ui_ic_clock" android:drawablePadding="10dp" android:drawableTint="@color/brand_primary" android:layout_weight="1" android:textSize="18sp" android:layout_marginStart="10dp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false" android:layout_marginTop="12dp">
      <Button android:id="@+id/btnEnableReminders" style="@style/MedicinePrimaryButton" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/reminder_enable" android:drawableStart="@drawable/ui_ic_bell" android:drawablePadding="10dp" android:drawableTint="#FFFFFF" android:layout_weight="1" android:textSize="18sp" />
      <Button android:id="@+id/btnDisableReminders" style="@style/MedicineSecondaryButton" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/reminder_disable" android:drawableStart="@drawable/ui_ic_bell" android:drawablePadding="10dp" android:drawableTint="@color/brand_primary" android:layout_weight="1" android:textSize="18sp" android:layout_marginStart="10dp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false" android:layout_marginTop="12dp">
      <Button android:id="@+id/btnReminderHelp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/reminder_help_title" android:textSize="18sp" style="@style/MedicineSecondaryButton" />
      <Button android:id="@+id/btnReminderBack" style="@style/MedicineSecondaryButton" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/reminder_back" android:drawableStart="@drawable/ui_ic_back" android:drawablePadding="10dp" android:drawableTint="@color/brand_primary" android:layout_weight="1" android:layout_marginStart="10dp" android:textSize="18sp" />
    </LinearLayout>
  </LinearLayout>
</ScrollView>
