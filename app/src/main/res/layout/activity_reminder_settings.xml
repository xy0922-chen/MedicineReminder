<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main" android:layout_width="match_parent"
    android:layout_height="match_parent" android:fillViewport="true" android:background="#F1F7F3">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/reminder_settings_title" android:textSize="28sp"
            android:textStyle="bold" android:textColor="#174D39" />
        <TextView android:id="@+id/tvReminderStatus" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="20dp"
            android:padding="18dp" android:background="@drawable/bg_medicine_card"
            android:textSize="20sp" android:textColor="#203B2E"
            android:accessibilityLiveRegion="polite" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/reminder_help"
            android:textSize="18sp" android:textColor="#52685A" />
        <Button android:id="@+id/btnNotificationPermission" style="@style/MedicineSecondaryButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/reminder_notification_permission" />
        <Button android:id="@+id/btnExactPermission" style="@style/MedicineSecondaryButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/reminder_exact_permission" />
        <Button android:id="@+id/btnEnableReminders" style="@style/MedicinePrimaryButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/reminder_enable" />
        <Button android:id="@+id/btnDisableReminders" style="@style/MedicineSecondaryButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/reminder_disable" />
        <Button android:id="@+id/btnReminderBack" style="@style/MedicineSecondaryButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/reminder_back" />
    </LinearLayout>
</ScrollView>
