<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp" android:background="@drawable/bg_board_card" android:layout_marginBottom="12dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
    <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ui_ic_check" android:padding="8dp" android:background="@drawable/bg_ui_icon" android:contentDescription="@null" android:importantForAccessibility="no" />
    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="" android:textSize="23sp" android:textColor="@color/app_ink" android:id="@+id/tvRecordName" android:layout_weight="1" android:layout_marginStart="12dp" android:textStyle="bold" />
  </LinearLayout>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/board_record_status" android:textSize="16sp" android:textColor="@color/brand_primary" android:background="@drawable/bg_status_green" android:padding="6dp" android:layout_marginTop="10dp" android:textStyle="bold" />
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="17sp" android:textColor="@color/app_muted" android:id="@+id/tvRecordDate" android:layout_marginTop="10dp" />
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="20sp" android:textColor="@color/app_ink" android:id="@+id/tvRecordDose" android:layout_marginTop="6dp" />
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="17sp" android:textColor="@color/app_muted" android:id="@+id/tvRecordPlan" android:layout_marginTop="6dp" />
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/board_record_imported" android:textSize="15sp" android:textColor="@color/app_muted" android:id="@+id/tvRecordImported" android:layout_marginTop="8dp" android:visibility="gone" />
</LinearLayout>
