<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F3F7F4">
  <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
    <ScrollView android:id="@+id/pageHome" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_brand" android:textSize="32sp" android:textColor="#174D39" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_subtitle" android:textSize="18sp" android:textColor="#66756D" android:layout_marginTop="4dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="24dp" android:padding="22dp" android:background="@drawable/bg_home_hero">
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_hero_title" android:textSize="24sp" android:textColor="#FFFFFF" android:textStyle="bold" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_hero_body" android:textSize="18sp" android:textColor="#E5F3E9" android:layout_marginTop="12dp" android:lineSpacingExtra="5dp" />
          <Button android:id="@+id/btnOpenMedicines" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_open_medicines" android:layout_marginTop="16dp" style="@style/MedicineSecondaryButton" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="18dp" android:padding="20dp" android:background="@drawable/bg_medicine_card">
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/overview_title" android:textSize="22sp" android:textColor="#203B2E" android:textStyle="bold" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/overview_loading" android:textSize="21sp" android:textColor="#246B50" android:id="@+id/tvTodayOverview" android:layout_marginTop="12dp" android:lineSpacingExtra="7dp" android:accessibilityLiveRegion="polite" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/overview_help" android:textSize="16sp" android:textColor="#66756D" android:layout_marginTop="10dp" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_quick_title" android:textSize="23sp" android:textColor="#203B2E" android:layout_marginTop="24dp" android:textStyle="bold" />
        <Button android:id="@+id/btnHomeAddMedicine" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_add_plan" android:layout_marginTop="10dp" style="@style/MedicinePrimaryButton" />
        <Button android:id="@+id/btnReminderSettings" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/reminder_settings_title" style="@style/MedicineSecondaryButton" />
        <Button android:id="@+id/btnHistory" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/history_title" style="@style/MedicineSecondaryButton" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_tip_title" android:textSize="20sp" android:textColor="#203B2E" android:layout_marginTop="22dp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_tip_body" android:textSize="18sp" android:textColor="#66756D" android:layout_marginTop="8dp" android:layout_marginBottom="12dp" android:lineSpacingExtra="4dp" />
      </LinearLayout>
    </ScrollView>
    <LinearLayout android:id="@+id/pageMedicines" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="20dp" android:visibility="gone">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/medicine_page_title" android:textSize="30sp" android:textColor="#174D39" android:textStyle="bold" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/medicine_page_subtitle" android:textSize="18sp" android:textColor="#66756D" android:layout_marginTop="4dp" />
      <Button android:id="@+id/btnAddMedicine" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_add_plan" android:layout_marginTop="18dp" style="@style/MedicinePrimaryButton" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/medicine_page_hint" android:textSize="17sp" android:textColor="#66756D" android:layout_marginTop="8dp" />
      <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="16dp">
        <ListView android:id="@+id/lvMedicine" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@android:color/transparent" android:dividerHeight="12dp" android:clipToPadding="false" android:paddingBottom="12dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/medicine_empty_body" android:textSize="20sp" android:textColor="#66756D" android:id="@+id/tvEmpty" android:background="@drawable/bg_medicine_card" android:padding="24dp" android:gravity="center" android:lineSpacingExtra="6dp" />
      </FrameLayout>
    </LinearLayout>
  </FrameLayout>
  <include layout="@layout/view_bottom_navigation" />
</LinearLayout>
