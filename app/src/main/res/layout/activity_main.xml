<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/app_background">
  <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
    <ScrollView android:id="@+id/pageHome" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
          <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/home_brand" android:textSize="30sp" android:textColor="@color/brand_primary_dark" android:layout_weight="1" android:textStyle="bold" />
          <ImageButton android:id="@+id/btnReminderSettings" android:layout_width="52dp" android:layout_height="52dp" android:padding="12dp" android:src="@drawable/ui_ic_sliders" android:background="@drawable/bg_ui_icon" android:contentDescription="@string/board_setting_desc" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_subtitle" android:textSize="17sp" android:textColor="@color/app_muted" android:layout_marginTop="6dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_home_hero" android:padding="20dp" android:layout_marginTop="20dp">
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/board_today" android:textSize="18sp" android:textColor="@color/hero_subtext" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/board_loading" android:textSize="23sp" android:textColor="#FFFFFF" android:id="@+id/tvHomeDate" android:layout_marginTop="6dp" android:textStyle="bold" />
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="20dp" android:baselineAligned="false">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
              <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textSize="28sp" android:textColor="#FFFFFF" android:id="@+id/tvHomePlanCount" android:gravity="center" android:textStyle="bold" />
              <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/board_stat_plans" android:textSize="15sp" android:textColor="@color/hero_subtext" android:gravity="center" android:layout_marginTop="6dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
              <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textSize="28sp" android:textColor="#FFFFFF" android:id="@+id/tvHomeRecordedCount" android:gravity="center" android:textStyle="bold" />
              <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/board_stat_recorded" android:textSize="15sp" android:textColor="@color/hero_subtext" android:gravity="center" android:layout_marginTop="6dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
              <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textSize="28sp" android:textColor="#FFFFFF" android:id="@+id/tvHomePendingCount" android:gravity="center" android:textStyle="bold" />
              <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/board_stat_pending" android:textSize="15sp" android:textColor="@color/hero_subtext" android:gravity="center" android:layout_marginTop="6dp" />
            </LinearLayout>
          </LinearLayout>
        </LinearLayout>
        <Button android:id="@+id/btnHomeAddMedicine" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_add_plan" android:layout_marginTop="16dp" android:drawableStart="@drawable/ui_ic_plus" android:drawablePadding="8dp" android:drawableTint="#FFFFFF" style="@style/MedicinePrimaryButton" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_board_card" android:padding="18dp" android:layout_marginTop="16dp">
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/board_progress_title" android:textSize="22sp" android:textColor="@color/app_ink" android:textStyle="bold" />
          <FrameLayout android:layout_width="180dp" android:layout_height="180dp" android:layout_gravity="center_horizontal">
            <com.example.medicinereminder.MedicationRingView android:id="@+id/homeRing" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
              <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textSize="32sp" android:textColor="@color/brand_primary_dark" android:id="@+id/tvHomePercent" android:gravity="center" android:textStyle="bold" />
              <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/board_no_plan_caption" android:textSize="16sp" android:textColor="@color/app_muted" android:id="@+id/tvHomeChartCaption" android:gravity="center" />
            </LinearLayout>
          </FrameLayout>
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="14dp" android:baselineAligned="false">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/board_loading" android:textSize="18sp" android:textColor="@color/chart_recorded_text" android:id="@+id/tvHomeRecordedLegend" android:layout_weight="1" android:gravity="center" android:drawableStart="@drawable/board_dot_green" android:drawablePadding="6dp" android:textStyle="bold" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/board_loading" android:textSize="18sp" android:textColor="@color/chart_pending_text" android:id="@+id/tvHomePendingLegend" android:layout_weight="1" android:gravity="center" android:drawableStart="@drawable/board_dot_gold" android:drawablePadding="6dp" android:textStyle="bold" />
          </LinearLayout>
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/board_scope_short" android:textSize="15sp" android:textColor="@color/app_muted" android:layout_marginTop="14dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="24dp">
          <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/board_pending_title" android:textSize="22sp" android:textColor="@color/app_ink" android:layout_weight="1" android:textStyle="bold" />
          <Button android:id="@+id/btnOpenMedicines" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/board_view_all" android:textSize="16sp" android:minHeight="48dp" android:padding="8dp" style="@style/MedicineSecondaryButton" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/homePendingPlans" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/board_loading" android:textSize="20sp" android:textColor="@color/app_muted" android:id="@+id/tvHomePendingEmpty" android:padding="24dp" android:background="@drawable/bg_board_soft" android:gravity="center" android:layout_marginTop="8dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="24dp">
          <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/board_recent_title" android:textSize="22sp" android:textColor="@color/app_ink" android:layout_weight="1" android:textStyle="bold" />
          <Button android:id="@+id/btnHistory" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/board_view_all" android:textSize="16sp" android:minHeight="48dp" android:padding="8dp" style="@style/MedicineSecondaryButton" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/homeRecentRecords" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/board_no_recent" android:textSize="18sp" android:textColor="@color/app_muted" android:id="@+id/tvHomeRecentEmpty" android:padding="20dp" android:background="@drawable/bg_board_soft" android:gravity="center" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_board_card" android:padding="18dp" android:layout_marginTop="16dp">
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/reminder_summary_title" android:textSize="22sp" android:textColor="@color/app_ink" android:textStyle="bold" />
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="18sp" android:textColor="@color/brand_primary" android:id="@+id/tvReminderSummary" android:layout_marginTop="12dp" android:background="@drawable/bg_status_neutral" android:padding="10dp" android:textStyle="bold" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="17sp" android:textColor="@color/app_muted" android:id="@+id/tvReminderDescription" android:layout_marginTop="10dp" android:lineSpacingExtra="4dp" />
          <Button android:id="@+id/btnManageReminderStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/reminder_summary_manage" android:textSize="18sp" android:layout_marginTop="10dp" style="@style/MedicineSecondaryButton" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/overview_loading" android:textSize="18sp" android:textColor="@color/app_muted" android:id="@+id/tvTodayOverview" android:visibility="gone" />
      </LinearLayout>
    </ScrollView>
    <LinearLayout android:id="@+id/pageMedicines" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="20dp" android:visibility="gone">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ui_ic_pill" android:padding="8dp" android:contentDescription="@null" android:importantForAccessibility="no" android:focusable="false" android:clickable="false" android:background="@drawable/bg_ui_icon" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/medicine_page_title" android:textSize="30sp" android:textColor="@color/brand_primary_dark" android:textStyle="bold" android:layout_weight="1" android:layout_marginStart="12dp" />
      </LinearLayout>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/medicine_page_subtitle" android:textSize="18sp" android:textColor="@color/app_muted" android:layout_marginTop="4dp" />
      <Button android:id="@+id/btnAddMedicine" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_add_plan" android:layout_marginTop="18dp" style="@style/MedicinePrimaryButton" android:drawableStart="@drawable/ui_ic_plus" android:drawablePadding="10dp" android:drawableTint="#FFFFFF" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/medicine_page_hint" android:textSize="17sp" android:textColor="@color/app_muted" android:layout_marginTop="8dp" />
      <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="16dp">
        <ListView android:id="@+id/lvMedicine" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@android:color/transparent" android:dividerHeight="12dp" android:clipToPadding="false" android:paddingBottom="12dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/medicine_empty_body" android:textSize="20sp" android:textColor="@color/app_muted" android:id="@+id/tvEmpty" android:background="@drawable/bg_medicine_card" android:padding="24dp" android:gravity="center" android:lineSpacingExtra="6dp" />
      </FrameLayout>
    </LinearLayout>
    <include layout="@layout/page_dashboard" />
  </FrameLayout>
  <include layout="@layout/view_bottom_navigation" />
</LinearLayout>
