<resources>
  <style name="MedicinePrimaryButton" parent="Widget.AppCompat.Button">
    <item name="android:textSize">22sp</item>
    <item name="android:textStyle">bold</item>
    <item name="android:textColor">@color/ui_button_primary_text</item>
    <item name="android:textAllCaps">false</item>
    <item name="android:minHeight">60dp</item>
    <item name="android:padding">12dp</item>
    <item name="backgroundTint">@null</item>
    <item name="android:backgroundTint">@null</item>
    <item name="android:background">@drawable/bg_ui_button_primary</item>
    <item name="android:stateListAnimator">@null</item>
    <item name="android:elevation">0dp</item>
    <item name="android:layout_marginTop">8dp</item>
    <item name="android:layout_marginBottom">4dp</item>
  </style>
  <style name="MedicineSecondaryButton" parent="MedicinePrimaryButton">
    <item name="android:textColor">@color/brand_primary_dark</item>
    <item name="backgroundTint">@null</item>
    <item name="android:backgroundTint">@null</item>
    <item name="android:background">@drawable/bg_ui_button_secondary</item>
    <item name="android:stateListAnimator">@null</item>
    <item name="android:elevation">0dp</item>
    <item name="android:layout_marginTop">8dp</item>
    <item name="android:layout_marginBottom">4dp</item>
  </style>
  <style name="MedicineDeleteButton" parent="MedicinePrimaryButton">
    <item name="android:textColor">@color/danger_text</item>
    <item name="backgroundTint">@null</item>
    <item name="android:backgroundTint">@null</item>
    <item name="android:background">@drawable/bg_ui_button_delete</item>
    <item name="android:stateListAnimator">@null</item>
    <item name="android:elevation">0dp</item>
    <item name="android:layout_marginTop">8dp</item>
    <item name="android:layout_marginBottom">4dp</item>
  </style>
  <style name="MedicineInput">
    <item name="android:textSize">22sp</item>
    <item name="android:textColor">@color/app_ink</item>
    <item name="android:textColorHint">@color/app_muted</item>
    <item name="android:minHeight">60dp</item>
    <item name="android:padding">14dp</item>
    <item name="android:background">@drawable/bg_ui_input</item>
    <item name="backgroundTint">@null</item>
    <item name="android:backgroundTint">@null</item>
  </style>
</resources>
